{
  "name": "owebstudio/kirby-whatsapp-button",
  "description": "Simple floating WhatsApp button plugin for Kirby.",
  "type": "kirby-plugin",
  "version": "2.0.0",
  "license": "MIT",
  "keywords": [
    "owebstudio",
    "owebstudio-plugin",
    "kirby",
    "kirby-plugin",
    "kirby-whatsapp"
  ],
  "homepage": "https://github.com/owebstudio/kirby-whatsapp-button",
  "support": {
    "issues": "https://github.com/owebstudio/kirby-whatsapp-button/issues",
    "source": "https://github.com/owebstudio/kirby-whatsapp-button"
  },
  "authors": [
    {
      "name": "oweb studio",
      "homepage": "https://github.com/owebstudio"
    }
  ],
  "config": {
    "optimize-autoloader": true,
    "preferred-install": "dist",
    "sort-packages": true
  },
  "require": {
    "php": "^8.2",
    "getkirby/composer-installer": "^1.2"
  },
  "extra": {
    "installer-name": "kirby-whatsapp-button",
    "kirby": {
      "compatible": "^5.0 || ^6.0"
    }
  }
}
